# Toolchain versions that are not pip packages, plus the ExecuTorch release every backend
# must match. EXECUTORCH_VERSION has to equal the executorch-android AAR the openweights app
# ships (gradle/libs.versions.toml there): a newer exporter can emit method names the older
# runtime does not know. tests/test_versions.py checks the pip pins agree with it.
EXECUTORCH_VERSION=1.4.0
PYTHON_VERSION=3.11
# QAIRT (Qualcomm AI Runtime SDK) the executorch 1.4.0 wheel is built against and downloads
# on first import (backends/qualcomm/scripts/qnn_config.sh). executorch-android-qnn:1.4.0
# depends on qnn-runtime 2.37.0. Used as the Actions cache key for the SDK.
QAIRT_VERSION=2.37.0.250724
# MediaTek NeuroPilot Express SDK: the archive ExecuTorch 1.4.0's CI installs
# (.ci/scripts/setup-mediatek-deps.sh), downloaded from MediaTek at run time and checked
# against this digest. Licensed by MediaTek Inc. under its own terms (THIRD_PARTY_NOTICES.md);
# nothing from it is committed, cached or re-published. mtk_converter is cp310-only.
NEUROPILOT_SDK_URL=https://s3.ap-southeast-1.amazonaws.com/mediatek.neuropilot.com/06302508-4c94-4bf2-9789-b0ee44e83e27.gz
NEUROPILOT_SDK_SHA256=d92a417877d955c6bd6018b173feed5f29c406ef04788ce9e8be3a9930dd8016
NEUROPILOT_SDK_BUILD=20250327
MTK_CONVERTER_VERSION=8.13.0
MTK_NEURON_VERSION=8.2.19
MTK_PYTHON_VERSION=3.10
# ExecuTorch source for examples/mediatek (the LLM export scripts are not in the wheel).
EXECUTORCH_COMMIT=3dd7ccd1d863fad22639dd2d918ae34a41ce45f0
